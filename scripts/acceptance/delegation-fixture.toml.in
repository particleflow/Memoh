# Isolated synthetic acceptance only. Values are generated by delegation_fixture.py.
[log]
level = "info"
format = "json"
[server]
addr = "127.0.0.1:$api_port"
rpc_listen_addr = "127.0.0.1:$rpc_port"
[admin]
username = "acceptance"
password = "$admin_password"
email = "acceptance@example.invalid"
[auth]
jwt_secret = "$jwt_secret"
jwt_expires_in = "2h"
agent_credentials_encryption_key = "$encryption_key"
[database]
driver = "postgres"
[postgres]
host = "127.0.0.1"
port = $pg_port
user = "acceptance"
password = "$pg_password"
database = "acceptance"
sslmode = "disable"
[pgvector]
enabled = false
[files]
originals_root = "$root/originals"
max_upload_bytes = 1048576
[container]
backend = "docker"
default_image = "$workspace_image"
image_pull_policy = "never"
data_root = "$data_root"
bridge_path = "$bridge_binary"
[docker]
host = ""
[registry]
providers_dir = "conf/providers"
[webhook_tunnel]
mode = "disabled"
[session_runtime]
backend = "redis"
cluster = true
state_ttl = "1h"
owner_lease_ttl = "2s"
backend_loss_grace = "6s"
[session_runtime.redis]
url = "redis://127.0.0.1:$queue_port/0"
key_prefix = "memoh:acceptance:$fixture_id:"
