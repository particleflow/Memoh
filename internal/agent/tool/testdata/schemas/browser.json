{
  "browser_action": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "description": "Browser action. Aliases accepted: dblclick, scrollintoview, keyboard_type, keyboard_inserttext; keydown/keyup dispatch one raw key event.",
        "enum": [
          "navigate",
          "click",
          "double_click",
          "focus",
          "type",
          "fill",
          "press",
          "hover",
          "select",
          "check",
          "uncheck",
          "scroll",
          "scroll_into_view",
          "drag",
          "upload",
          "wait",
          "go_back",
          "go_forward",
          "reload",
          "tab_new",
          "tab_select",
          "tab_close"
        ],
        "type": "string"
      },
      "amount": {
        "default": 500,
        "description": "Scroll amount in pixels.",
        "maximum": 5000,
        "minimum": 1,
        "type": "integer"
      },
      "direction": {
        "description": "Scroll direction; default down.",
        "enum": [
          "up",
          "down",
          "left",
          "right"
        ],
        "type": "string"
      },
      "files": {
        "description": "Workspace file paths to upload.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "key": {
        "description": "Key or chord for press (Enter, Control+a).",
        "type": "string"
      },
      "ref": {
        "description": "Element ref (e12) from a snapshot or screenshot annotation; preferred over selector.",
        "type": "string"
      },
      "selector": {
        "description": "CSS selector when no ref is available.",
        "type": "string"
      },
      "tab_index": {
        "description": "Tab index for tab_select or tab_close.",
        "minimum": 0,
        "type": "integer"
      },
      "target_ref": {
        "description": "Drag drop-target ref; preferred over target_selector.",
        "type": "string"
      },
      "target_selector": {
        "description": "Drag drop-target CSS selector when no ref.",
        "type": "string"
      },
      "text": {
        "description": "Text for type or fill.",
        "type": "string"
      },
      "timeout": {
        "default": 1000,
        "description": "Timeout in ms for wait or navigation readiness.",
        "maximum": 45000,
        "minimum": 1,
        "type": "integer"
      },
      "url": {
        "description": "URL to open for navigate or tab_new.",
        "type": "string"
      },
      "value": {
        "description": "Option value for select.",
        "type": "string"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "browser_observe": {
    "additionalProperties": false,
    "properties": {
      "full_page": {
        "default": false,
        "description": "Capture a full-page screenshot for screenshot.",
        "type": "boolean"
      },
      "observe": {
        "description": "What to observe from the page.",
        "enum": [
          "snapshot",
          "get_content",
          "screenshot_annotate",
          "screenshot",
          "get_html",
          "evaluate",
          "get_url",
          "get_title",
          "pdf",
          "tab_list"
        ],
        "type": "string"
      },
      "ref": {
        "description": "Element ref from snapshot or screenshot_annotate; scopes get_content/get_html and evaluate.",
        "type": "string"
      },
      "script": {
        "description": "JavaScript expression; keep it short and read-only unless the task requires otherwise.",
        "type": "string"
      },
      "selector": {
        "description": "CSS selector scoping get_content/get_html when no ref.",
        "type": "string"
      }
    },
    "required": [
      "observe"
    ],
    "type": "object"
  },
  "browser_remote_session": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "description": "Session action to perform.",
        "enum": [
          "create",
          "close",
          "status"
        ],
        "type": "string"
      },
      "session_id": {
        "description": "Target/session ID returned by create or status.",
        "type": "string"
      },
      "url": {
        "description": "URL to open when creating a target.",
        "type": "string"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "computer_action": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "description": "Desktop action to perform.",
        "enum": [
          "click",
          "double_click",
          "type",
          "fill",
          "key",
          "scroll",
          "drag",
          "wait",
          "mouse_move",
          "pointer"
        ],
        "type": "string"
      },
      "amount": {
        "default": 500,
        "description": "Scroll amount or wait duration in milliseconds.",
        "maximum": 10000,
        "minimum": 1,
        "type": "integer"
      },
      "button": {
        "description": "Mouse button; default left.",
        "enum": [
          "left",
          "middle",
          "right"
        ],
        "type": "string"
      },
      "button_mask": {
        "description": "Raw button mask for pointer actions.",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "direction": {
        "description": "Scroll direction; default down.",
        "enum": [
          "up",
          "down",
          "left",
          "right"
        ],
        "type": "string"
      },
      "key": {
        "description": "Key or chord (Enter, Control+a).",
        "type": "string"
      },
      "ref": {
        "description": "Element ref (e3) from a desktop snapshot; preferred over coordinates for click/double_click/type/fill/scroll.",
        "type": "string"
      },
      "text": {
        "description": "Text to type or fill into the target.",
        "type": "string"
      },
      "to_x": {
        "description": "Drag destination X.",
        "minimum": 0,
        "type": "integer"
      },
      "to_y": {
        "description": "Drag destination Y.",
        "minimum": 0,
        "type": "integer"
      },
      "x": {
        "description": "X coordinate in desktop pixels (fallback when no ref).",
        "minimum": 0,
        "type": "integer"
      },
      "y": {
        "description": "Y coordinate in desktop pixels (fallback when no ref).",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "computer_observe": {
    "additionalProperties": false,
    "properties": {
      "observe": {
        "description": "What to observe from the desktop.",
        "enum": [
          "snapshot",
          "screenshot"
        ],
        "type": "string"
      }
    },
    "required": [
      "observe"
    ],
    "type": "object"
  }
}
