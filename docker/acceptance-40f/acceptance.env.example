# Copy outside the checkout; fill only after the deployment location is agreed.
# Absolute NEW directory, basename memoh-acceptance-40f0a69. No production paths.
ACCEPTANCE_ROOT=
# Existing local PostgreSQL 18 image, e.g. postgres@sha256:<verified digest>.
# The three application images are already fixed in compose.yaml/config.toml.
ACCEPTANCE_POSTGRES_IMAGE=
# Unused port, bound only to 127.0.0.1. No ingress/TLS changes are implied.
ACCEPTANCE_WEB_PORT=
